{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dashboard: Django backend (F5)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "127.0.0.1:8000"],
      "django": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Dashboard: Django tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["backend/tests", "-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Dashboard: frontend (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --host 127.0.0.1",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Dashboard: frontend + backend",
      "configurations": ["Dashboard: Django backend (F5)", "Dashboard: frontend (Vite)"]
    }
  ]
}
